FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Comma-separated allowed frontend origins for CORS. "*" is fine for
# local dev; set explicitly (e.g. https://your-frontend.onrender.com)
# before deploying, or credentialed requests are accepted from any
# origin -- see app/config.py's comment for why.
CORS_ORIGINS=*

DATABASE_URL=postgresql+psycopg2://siteforge:siteforge@localhost:5432/siteforge
TEST_DATABASE_URL=postgresql+psycopg2://siteforge:siteforge@localhost:5432/siteforge_test

# Dedicated role for the pre-authentication login lookup -- see
# scripts/setup_auth_role.sql and README's "Why there's a second
# database role" note. Falls back to DATABASE_URL if unset.
AUTH_DATABASE_URL=postgresql+psycopg2://siteforge_auth:change-me-in-production@localhost:5432/siteforge

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=siteforge-documents
S3_BACKUP_BUCKET=siteforge-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=

ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-sonnet-4-6

SENTRY_DSN=
